# fake | gemini | openai  (fake 는 키 없이 흐름만 확인)
AI_PROVIDER=fake
GEMINI_API_KEY=
OPENAI_API_KEY=
SONIOX_API_KEY=

# 초대 링크 접속 코드. 배포할 때 꼭 정한다. 비워 두면 확인하지 않는다(로컬 개발)
# 초대 링크: https://<프론트 주소>/?code=<이 값>&room=<방 코드>
ACCESS_CODE=
# 배포한 프론트 주소를 더한다(JSON 배열)
# CORS_ORIGINS=["http://localhost:3000","https://<프론트 주소>"]

# 참여자 한 명 기준 사용량 한도(0 이면 끔). 기본값은 app/config.py
# RATE_SEGMENTS_PER_MIN=120
# RATE_MESSAGES_PER_MIN=30
# RATE_OPINIONS_PER_MIN=20
# RATE_SONIOX_KEYS_PER_HOUR=30

# 비워 두면 메모리 저장소를 쓴다(재시작하면 사라짐)
SUPABASE_URL=
# 서버 전용 키. 새 secret key(sb_secret_…) 또는 예전 service_role 키. 프론트에 넣으면 안 된다
SUPABASE_SERVICE_ROLE_KEY=

# 실험 조건 (app/config.py 에 전체 목록)
TRANSLATION_REFINE_PREVIOUS=false
OPINION_EXTRA_ENGLISH=false
# 확정 전 글자도 계속 번역해 다른 화면에 보여 준다. 이어 말하는 동안 번역 호출이 1초에 한 번꼴로 는다
INTERIM_TRANSLATION_ENABLED=false
